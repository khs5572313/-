# 필수: Claude API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 네이버 CLOVA OCR(General) — 설정하면 2차 판독 엔진으로 자동 사용
# CLOVA_OCR_URL=https://xxxx.apigw.ntruss.com/custom/v1/xxxx/xxxx/general
# CLOVA_OCR_SECRET=...

# 선택: 세부 조정
# DOCREAD_MODEL=claude-opus-5-5
# DOCREAD_EFFORT_TRANSCRIBE=high
# DOCREAD_WORK_WIDTH=2400
# DOCREAD_DATA_DIR=./data
